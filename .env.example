# Copy to .env for local development. In production, set these in the container environment.

# Address the server listens on.
BAUTH_BIND_ADDR=0.0.0.0:8401
# Public base URL, used as the `iss` claim. No trailing slash.
BAUTH_ISSUER=http://localhost:8401
# Postgres; bauth only uses the `bauth` schema, so it can share a database.
BAUTH_DATABASE_URL=postgres://bauth:bauth@localhost:5432/bauth
# Encrypts signing keys stored in the database. Generate with: openssl rand -base64 32
# Losing it invalidates every issued token.
BAUTH_MASTER_KEY=
# Clients configuration (redirect URIs, magic link and reset pages…).
BAUTH_CONFIG=bauth.toml

# Emails: Mailpit locally (podman compose up -d mailpit, UI on http://localhost:8026).
# Production: smtps://user:password@smtp.example.com:465
BAUTH_SMTP_URL=smtp://localhost:1025
BAUTH_MAIL_FROM=bauth <no-reply@example.com>
# App page that receives `#token=…` from verification and email change links.
BAUTH_VERIFICATION_URL=http://localhost:8025/auth/verify-email

# Comma-separated IPs (reverse proxy, app servers) allowed to set X-Forwarded-For.
BAUTH_TRUSTED_PROXIES=

RUST_LOG=info,sqlx=warn

# Tests only: the `postgres-test` service of docker-compose.yml (podman compose up -d postgres-test).
DATABASE_URL=postgres://bauth:bauth@localhost:5440/postgres
