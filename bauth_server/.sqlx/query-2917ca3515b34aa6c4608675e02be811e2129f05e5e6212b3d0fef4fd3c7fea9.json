  "query": "\n        UPDATE bauth.login_flows\n        SET magic_link_requests = magic_link_requests + 1\n        WHERE id = $1 AND completed_at IS NULL AND expires_at > now()\n        RETURNING client_id, magic_link_requests AS requests, expires_at\n        ",
