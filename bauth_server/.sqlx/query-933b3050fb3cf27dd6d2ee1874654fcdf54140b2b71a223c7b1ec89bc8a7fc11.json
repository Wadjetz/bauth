  "query": "\n        SELECT s.user_id, u.email\n        FROM bauth.sessions s\n        JOIN bauth.users u ON u.id = s.user_id\n        WHERE s.id = $1\n          AND s.revoked_at IS NULL\n          AND s.expires_at > now()\n          AND u.disabled_at IS NULL\n        ",
