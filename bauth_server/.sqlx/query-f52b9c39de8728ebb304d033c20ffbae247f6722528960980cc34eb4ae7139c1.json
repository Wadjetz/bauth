  "query": "\n        SELECT u.id AS user_id, p.password_hash, u.email_verified_at, u.disabled_at\n        FROM bauth.users u\n        JOIN bauth.password_credentials p ON p.user_id = u.id\n        WHERE u.email = lower(btrim($1))\n        ",
