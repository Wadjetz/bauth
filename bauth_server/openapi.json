        "properties": {
          "client_id": {
            "type": "string"
          },
          "code_challenge": {
            "type": "string"
          },
          "code_challenge_method": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          },
          "state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque value echoed back to the app with the code (CSRF protection on redirects)."
          }
        }
      },
      "DeleteAccountRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Error of every app route. Apps translate `code`, which is stable; `message` is for developers.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "invalid_credentials"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FlowResponse": {
        "type": "object",
        "required": [
          "flow_id",
          "methods",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "flow_id": {
            "type": "string",
            "format": "uuid"
          },
          "methods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoginMethod"
            }
          }
        }
      },
      "LoginMethod": {
        "type": "string",
        "enum": [
          "password",
          "magic_link"
        ]
      },
      "LoginResponse": {
        "oneOf": [
          {
            "type": "object",
            "description": "Exchange `code` on `/oauth/token` with the PKCE `code_verifier`.",
            "required": [
              "code",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed"
                ]
              }
            }
          }
        ],
        "description": "What a login method returns once the user is authenticated."
