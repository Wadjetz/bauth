      "MagicCodeRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The 6 digits of the magic link email, without spaces.",
            "example": "042917"
          }
        }
      },
      "MagicLinkRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "MagicLinkResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/MagicLinkStatus"
          }
        }
      },
      "MagicLinkStatus": {
        "type": "string",
        "enum": [
          "magic_link_sent"
        ]
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "id",
          "email",
          "email_verified",
          "has_password",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "has_password": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "OAuthErrorBody": {
        "type": "object",
        "description": "RFC 6749 §5.2 error.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "error_description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PasswordRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RecoveryRequest": {
        "type": "object",
        "required": [
          "client_id",
          "email"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "RecoveryResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/RecoveryStatus"
          }
        }
      },
      "RecoveryStatus": {
        "type": "string",
        "enum": [
          "recovery_sent"
        ]
      },
      "RegistrationRequest": {
        "type": "object",
        "required": [
          "client_id",
          "email",
          "password"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegistrationResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/RegistrationStatus"
          }
        }
      },
      "RegistrationStatus": {
        "type": "string",
        "enum": [
          "verification_sent"
        ]
      },
      "ResendRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "ResendResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ResendStatus"
          }
        }
      },
      "ResendStatus": {
        "type": "string",
        "enum": [
          "verification_sent"
        ]
      },
      "ResetRequest": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "RevokeRequest": {
        "type": "object",
        "description": "RFC 7009. `token_type_hint` is accepted and ignored: only refresh tokens can be revoked,\naccess tokens are JWTs that stay valid until they expire (15 min).",
        "required": [
          "token",
          "client_id"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "id",
          "client_id",
          "created_at",
          "last_used_at",
          "expires_at",
          "current"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name from bauth.toml, `None` if the client was removed since."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean",
            "description": "The session this request's access token belongs to."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "description": "`application/x-www-form-urlencoded`, as required by RFC 6749 §4.1.3.",
        "required": [
          "grant_type",
          "client_id"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "code_verifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "grant_type": {
            "type": "string"
          },
          "redirect_uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "refresh_token": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token"
