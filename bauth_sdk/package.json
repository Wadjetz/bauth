{
  "name": "@wadjetz/bauth-client",
  "version": "0.1.0",
  "description": "Framework-agnostic client for the bauth authentication server",
  "keywords": [
    "bauth",
    "authentication",
    "oauth",
    "pkce",
    "magic-link",
    "sdk"
  ],
  "homepage": "https://github.com/Wadjetz/bauth/tree/master/bauth_sdk#readme",
  "bugs": "https://github.com/Wadjetz/bauth/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wadjetz/bauth.git",
    "directory": "bauth_sdk"
  },
  "license": "MIT",
  "author": "Egor Berezovskiy",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "openapi-typescript ../bauth_server/openapi.json -o src/schema.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/",
    "prepack": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
